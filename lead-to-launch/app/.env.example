# Copy to .env.local for local dev. Set the same keys in Vercel > Settings > Environment Variables.
# Never commit real values.

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Lead scraping (Apify). Without this, /api/scrape returns an error unless DEMO_MODE=true.
APIFY_TOKEN=

# Optional: real website speed audits
GOOGLE_PAGESPEED_KEY=

# Optional: live market research in the Build step
TAVILY_API_KEY=

# Set to true ONLY for demos. Serves fake seed leads instead of real scrapes.
DEMO_MODE=false

# Site generation (Phase 4). Pick ONE engine, or neither and use free manual mode.
#
# Free engine: a Gemini key from Google AI Studio (aistudio.google.com), no billing needed. Rate limited.
# Free-tier prompts may be used by Google to improve its products. We only send public business data.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
#
# Paid engine, best design quality. Spends real credits.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Optional: force an engine when both keys exist (gemini or anthropic). Anthropic wins by default.
LLM_PROVIDER=
# Required to use the API engines. Comma-separated emails allowed to spend credits. Empty means generation is off.
GENERATION_ALLOWED_EMAILS=

# Convex (saved leads database). Create a project at convex.dev.
# The deployment URL is public and safe to expose. Find it in the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=
# Lets Vercel builds deploy the Convex functions. Production environment only in Vercel.
CONVEX_DEPLOY_KEY=

# Copy to .env.local for local dev. Set the same keys in Vercel > Settings > Environment Variables.
# Never commit real values.

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Lead scraping (Apify). Without this, /api/scrape returns an error unless DEMO_MODE=true.
APIFY_TOKEN=

# Optional: real website speed audits
GOOGLE_PAGESPEED_KEY=

# Optional: live market research in the Build step
TAVILY_API_KEY=

# Set to true ONLY for demos. Serves fake seed leads instead of real scrapes.
DEMO_MODE=false
